<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Tasks</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <div class="app-card">
    <div class="top-bar">
      <h2>Hello, <%= user.username %></h2>
      <a href="/logout" class="logout-btn">Logout</a>
    </div>

    <form action="/tasks" method="POST" class="task-form">
      <input type="text" name="title" placeholder="Add a new task..." required>
     <input type="datetime-local" name="due_date" required>
      <button type="submit" class="btn">Add</button>
    </form>

    <div class="filters">
      <a href="/tasks?filter=all" class="<%= activeFilter === 'all' ? 'active' : '' %>">All</a>
      <a href="/tasks?filter=pending" class="<%= activeFilter === 'pending' ? 'active' : '' %>">Pending</a>
      <a href="/tasks?filter=completed" class="<%= activeFilter === 'completed' ? 'active' : '' %>">Completed</a>
    </div>

    <div class="task-list">
      <% if (tasks.length === 0) { %>
        <p style="text-align: center; color: #9ca3af; padding: 20px 0;">No tasks found.</p>
      <% } %>
<% tasks.forEach(task => { %>
        <div class="task-item <%= task.status === 'completed' ? 'completed' : '' %> <%= task.status === 'overdue' ? 'overdue' : '' %>">
          <div>
            <span><%= task.title %></span>
            <% if (task.status === 'overdue') { %>
              <small style="color: #ef4444; display: block; font-size: 11px; font-weight: bold;">(Overdue)</small>
            <% } %>
          </div>
          <div class="actions">
            <% if (task.status === 'pending' || task.status === 'overdue') { %>
              <form action="/tasks/<%= task._id %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="status" value="completed">
                <button type="submit" class="btn btn-secondary btn-sm">Complete</button>
              </form>
            <% } else if (task.status === 'completed') { %>
              <form action="/tasks/<%= task._id %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="status" value="pending">
                <button type="submit" class="btn btn-secondary btn-sm">Undo</button>
              </form>
            <% } %>

            <form action="/tasks/<%= task._id %>/status" method="POST" style="display:inline;">
              <input type="hidden" name="status" value="deleted">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>

           
    </div>
  </div>

  <!-- Include Socket.io Client Library -->
<script src="/socket.io/socket.io.js"></script>
<script>
  // Connect to the WebSocket server
  const socket = io();

  // Listen for real-time task notifications from server
  socket.on("taskNotification", (data) => {
    alert(`Notification: ${data.message}`);
    // Optionally reload or dynamically update task list
    setTimeout(() => location.reload(), 1500);
  });

  socket.on("connect", () => {
    console.log("Connected to real-time notification socket standard:", socket.id);
  });
</script>
</body>
</body>
</html>
